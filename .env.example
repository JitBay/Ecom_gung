# Domaine Shopify sécurisé pour le passage en caisse (Checkout)
VITE_SHOPIFY_STORE_DOMAIN=checkout.zvar-shop.com

# Token public Storefront API
VITE_SHOPIFY_STOREFRONT_TOKEN=06705ec8a9335df76b9e68a23ee31bf5

# Tracking & Analytics (optionnels — à renseigner dans Vercel Environment Variables)
# VITE_META_PIXEL_ID=123456789012345
# VITE_TIKTOK_PIXEL_ID=CXXXXXXXXXXXXXXX
# VITE_GA4_ID=G-XXXXXXXXXX
# VITE_CLARITY_ID=xxxxxxxxxx

# Endpoint formulaire Contact (optionnel, par défaut FormSubmit vers support@zvar-shop.com)
# VITE_CONTACT_ENDPOINT=https://formsubmit.co/ajax/support@zvar-shop.com
